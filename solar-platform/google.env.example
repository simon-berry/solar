# Copy to .env.google for Compose and chmod 600 .env.google.
# Native Node: use the supervisor environment or protected .env instead.
# Public browser key: restrict by website referrer and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_API_KEY=
# Private server keys: restrict by server egress IP and corresponding API.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_SOLAR_API_KEY=
